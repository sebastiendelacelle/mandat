rules_version = '2';
// Règles de sécurité Firestore pour Mandat
// - chacun lit et écrit ses propres sauvegardes, personne d'autre ;
// - les états publiés en multijoueur sont lisibles par les joueurs connectés, modifiables par leur seul auteur ;
// - les messages ne sont lisibles que par leur expéditeur et leur destinataire.
service cloud.firestore {
  match /databases/{database}/documents {
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /mp/{uid}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /mpgames/{gid} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.host == resource.data.host
        && request.resource.data.members.size() <= 8;
    }
    match /mpres/{id} {
      allow read, create, update: if request.auth != null;
    }
    match /mpinv/{id} {
      allow read, create: if request.auth != null;
    }
    match /locks/{id} {
      allow read, write: if request.auth != null;
    }
    match /mpdeb/{id} {
      allow read, create, update: if request.auth != null;
    }
    match /mpmsg/{id} {
      allow read: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null && resource.data.to == request.auth.uid;
    }
  }
}
